rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidBloodSugarRecord(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.valueMgDl is int &&
             data.valueMgDl >= 20 &&
             data.valueMgDl <= 600 &&
             data.timing is string &&
             data.timing in ['FASTING', 'BEFORE_MEAL', 'AFTER_MEAL', 'BEDTIME'] &&
             data.measuredDate is string &&
             data.measuredDate.size() == 10 &&
             data.measuredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.measuredTimeText is string &&
             data.measuredTimeText.size() >= 1 &&
             data.measuredTimeText.size() <= 30 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 120)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/bloodSugarRecords/{recordId} {
      allow get: if isOwner(userId) && isValidId(recordId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(recordId) &&
                       incoming().keys().hasAll(['userId', 'valueMgDl', 'timing', 'measuredDate', 'measuredTimeText', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'valueMgDl', 'timing', 'measuredDate', 'measuredTimeText', 'note', 'createdAt', 'updatedAt']) &&
                       isValidBloodSugarRecord(incoming());
      allow update: if isOwner(userId) &&
                       isValidId(recordId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().keys().hasOnly(['userId', 'valueMgDl', 'timing', 'measuredDate', 'measuredTimeText', 'note', 'createdAt', 'updatedAt']) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['valueMgDl', 'timing', 'measuredDate', 'measuredTimeText', 'note', 'updatedAt']) &&
                       isValidBloodSugarRecord(incoming());
      allow delete: if isOwner(userId) && isValidId(recordId);
    }
  }
}
